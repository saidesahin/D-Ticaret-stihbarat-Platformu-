# Gelistirme icin varsayilan SQLite yeterli. Production'da PostgreSQL'e cevir:
# DATABASE_URL=postgresql://kullanici:sifre@localhost:5432/dis_ticaret_db
DATABASE_URL=sqlite:///./dev.db

# Onemli: production'a cikmadan bunu mutlaka rastgele/uzun bir degerle degistir
SECRET_KEY=degistir-bu-anahtar-gelistirme-icin

# Modul 1+ icin ileride kullanilacak (simdilik bos birak)
SERPAPI_KEY=
GOOGLE_PLACES_API_KEY=
IPINFO_TOKEN=
